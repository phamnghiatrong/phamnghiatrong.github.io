---
/**
 * Nhãn trụ cột blog: một màu duy nhất, góc vuông.
 * Có `href` thì là link (có hiệu ứng khi trỏ chuột), không thì chỉ là nhãn.
 */
import { useT, type Locale } from '../../i18n';
import type { BlogTag } from '../../lib/schemas';

interface Props {
  tag: BlogTag;
  locale: Locale;
  href?: string;
}

const { tag, locale, href } = Astro.props;
const label = useT(locale).blog.tags[tag];
---

{
  href ? (
    <a class="tag-label tag-link" href={href}>
      {label}
    </a>
  ) : (
    <span class="tag-label">{label}</span>
  )
}

<style>
  .tag-label {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 0;
    background: var(--green-soft);
    color: var(--green);
    font-size: 13px;
    line-height: 1.4;
    white-space: nowrap;
    text-decoration: none;
  }
  .tag-link {
    transition: transform var(--ease), box-shadow var(--ease);
  }
  .tag-link:hover {
    color: var(--green);
    transform: translateY(var(--lift-btn));
    box-shadow: var(--shadow-lift);
  }
</style>
