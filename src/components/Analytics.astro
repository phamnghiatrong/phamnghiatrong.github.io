---
/**
 * Đếm lượt xem bằng GoatCounter (miễn phí, không dùng cookie) và hiện số lượt xem công khai.
 *
 * Bật: ghi mã GoatCounter vào src/data/site.json → "goatcounter", và trong trang cài đặt GoatCounter
 * bật "Allow adding visitor counts on your website". Để trống mã thì không đếm, không hiện gì.
 *
 * - `statsPath`: gộp lượt xem vào một đường dẫn chung (bài blog: 3 bản ngôn ngữ tính chung vào /blog/<tên>/).
 * - Chỗ nào cần hiện số lượt xem thì đặt <ViewCount path="..." /> — script bên dưới tự điền số.
 * - Chạy thử trên máy (localhost) GoatCounter tự bỏ qua, không đếm.
 */
import { site } from '../lib/data';

interface Props {
  statsPath?: string;
}

const { statsPath } = Astro.props;
const code = site.goatcounter;
const settings = statsPath ? JSON.stringify({ path: statsPath }) : undefined;
---

{
  code && (
    <script
      is:inline
      data-goatcounter={`https://${code}.goatcounter.com/count`}
      data-goatcounter-settings={settings}
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}

<script>
  // Điền số lượt xem vào các phần tử [data-views] (lấy từ API công khai của GoatCounter)
  const tag = document.querySelector<HTMLScriptElement>('script[data-goatcounter]');
  const targets = [...document.querySelectorAll<HTMLElement>('[data-views]')];

  if (tag && targets.length > 0) {
    const base = tag.dataset.goatcounter!.replace(/\/count$/, '');
    const format = new Intl.NumberFormat(document.documentElement.lang || 'vi');
    const requests = new Map<string, Promise<number | null>>();

    const load = (path: string) => {
      if (!requests.has(path)) {
        requests.set(
          path,
          fetch(`${base}/counter/${encodeURIComponent(path)}.json`)
            .then(async (res) => {
              if (res.status === 404) return 0; // chưa có lượt xem nào
              if (!res.ok) return null;
              const data = (await res.json()) as { count?: string };
              return Number(String(data.count ?? '0').replace(/\D/g, ''));
            })
            .catch(() => null), // bị chặn / mất mạng: giữ ẩn
        );
      }
      return requests.get(path)!;
    };

    for (const el of targets) {
      load(el.dataset.views!).then((n) => {
        if (n === null) return;
        el.textContent = (el.dataset.template ?? '{n}').replace('{n}', format.format(n));
        el.hidden = false;
      });
    }
  }
</script>
