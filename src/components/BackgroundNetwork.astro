---
/**
 * Nền chuyển động toàn trang: mạng lưới điểm nối, vẽ bằng canvas (không dùng video).
 *
 * - Vẽ theo độ phân giải thật của màn hình → luôn nét; chỉ vài KB code, hiện ngay khi mở trang.
 * - Điểm trôi chậm theo 3 lớp độ sâu; hai điểm gần nhau thì hiện đường nối (càng gần càng sáng);
 *   vài đốm sáng mờ phía sau (CSS) tạo chiều sâu; rê chuột thì các điểm gần con trỏ nối về con trỏ.
 * - Luôn tự chạy khi vào trang (không có nút dừng — theo yêu cầu chủ site).
 * - Tự dừng khi tab bị ẩn để đỡ tốn pin.
 * - Tối ưu cho điện thoại: nền tĩnh vẽ bằng CSS (một lần), đường nối gom theo độ sáng vẽ theo lượt,
 *   30 khung/giây.
 *
 * Chỉnh giao diện: sửa các hằng số trong CONFIG bên dưới; màu nền tĩnh ở phần <style>.
 */
---

<canvas class="net-bg" aria-hidden="true" data-net-bg></canvas>

<script>
  const CONFIG = {
    /** Mật độ: 1 điểm cho mỗi ngần này px² màn hình (nhỏ hơn = dày hơn) */
    areaPerNode: 7000,
    minNodes: 35,
    maxNodes: 230,
    /** Khoảng cách tối đa để hai điểm nối với nhau (px) */
    linkDistance: 175,
    /** Tốc độ trôi (px mỗi khung hình ở 60 fps) */
    speedMin: 0.08,
    speedMax: 0.3,
    /** Số khung hình mỗi giây (chuyển động chậm nên 30 là đủ mượt, đỡ tốn máy) */
    fps: 30,
    /** Bán kính vùng nối về con trỏ chuột (px) */
    pointerRadius: 180,
    colors: {
      line: '175, 225, 240', // r, g, b
      dot: '235, 248, 255',
    },
  };

  type Node = { x: number; y: number; vx: number; vy: number; z: number; r: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-net-bg]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    let w = 0;
    let h = 0;
    const nodes: Node[] = [];
    let running = false;
    let frameId = 0;
    let last = 0;
    const pointer = { x: -1e4, y: -1e4 };
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // Gom đường nối theo độ sáng (LEVELS mức): mỗi mức chỉ vẽ một lượt → nhanh hơn rất nhiều
    const LEVELS = 8;
    const buckets: number[][] = Array.from({ length: LEVELS }, () => []);

    function makeNode(x: number, y: number): Node {
      const z = rand(0.35, 1); // độ sâu: 1 = gần, sáng, nhanh; 0.35 = xa, mờ, chậm
      const angle = rand(0, Math.PI * 2);
      const speed = rand(CONFIG.speedMin, CONFIG.speedMax) * z;
      return { x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, z, r: 0.8 + z * 2 };
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.lineCap = 'round';

      const target = Math.round(Math.min(CONFIG.maxNodes, Math.max(CONFIG.minNodes, (w * h) / CONFIG.areaPerNode)));
      while (nodes.length < target) nodes.push(makeNode(rand(0, w), rand(0, h)));
      nodes.length = target;
      for (const n of nodes) {
        if (n.x > w) n.x = rand(0, w);
        if (n.y > h) n.y = rand(0, h);
      }
      draw();
    }

    function step(dt: number) {
      const m = 40; // ra khỏi màn hình một chút rồi mới quay lại phía bên kia
      for (const n of nodes) {
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (n.x < -m) n.x = w + m;
        else if (n.x > w + m) n.x = -m;
        if (n.y < -m) n.y = h + m;
        else if (n.y > h + m) n.y = -m;
      }
    }

    function strokeBuckets(c: CanvasRenderingContext2D, maxAlpha: number, width: number) {
      c.lineWidth = width;
      for (let k = 0; k < LEVELS; k++) {
        const seg = buckets[k];
        if (seg.length === 0) continue;
        c.strokeStyle = `rgba(${CONFIG.colors.line}, ${((k + 0.5) / LEVELS) * maxAlpha})`;
        c.beginPath();
        for (let i = 0; i < seg.length; i += 4) {
          c.moveTo(seg[i], seg[i + 1]);
          c.lineTo(seg[i + 2], seg[i + 3]);
        }
        c.stroke();
        seg.length = 0;
      }
    }

    function draw() {
      const c = ctx!;
      const { dot } = CONFIG.colors;
      c.clearRect(0, 0, w, h);

      // Đường nối giữa các điểm gần nhau (càng gần, càng ở lớp gần → càng sáng)
      const maxD = Math.min(CONFIG.linkDistance, Math.max(120, w / 7));
      const maxD2 = maxD * maxD;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > maxD2) continue;
          const strength = (1 - Math.sqrt(d2) / maxD) * Math.min(a.z, b.z); // 0..1
          buckets[Math.min(LEVELS - 1, Math.floor(strength * LEVELS))].push(a.x, a.y, b.x, b.y);
        }
      }
      strokeBuckets(c, 0.9, 1);

      // Nối về con trỏ chuột
      const pr = CONFIG.pointerRadius;
      for (const n of nodes) {
        const dx = n.x - pointer.x;
        const dy = n.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > pr * pr) continue;
        const strength = (1 - Math.sqrt(d2) / pr) * n.z;
        buckets[Math.min(LEVELS - 1, Math.floor(strength * LEVELS))].push(n.x, n.y, pointer.x, pointer.y);
      }
      strokeBuckets(c, 0.45, 0.6);

      // Quầng sáng nhẹ quanh điểm ở lớp gần (một lượt)
      c.fillStyle = `rgba(${dot}, 0.16)`;
      c.beginPath();
      for (const n of nodes) {
        if (n.z <= 0.8) continue;
        c.moveTo(n.x + n.r * 3, n.y);
        c.arc(n.x, n.y, n.r * 3, 0, Math.PI * 2);
      }
      c.fill();

      // Điểm: 3 mức độ sáng theo độ sâu, mỗi mức một lượt
      for (let level = 0; level < 3; level++) {
        const lo = 0.35 + (level * 0.65) / 3;
        const hi = level === 2 ? 1.01 : lo + 0.65 / 3;
        c.fillStyle = `rgba(${dot}, ${0.5 + ((lo + Math.min(hi, 1)) / 2) * 0.5})`;
        c.beginPath();
        for (const n of nodes) {
          if (n.z < lo || n.z >= hi) continue;
          c.moveTo(n.x + n.r, n.y);
          c.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        }
        c.fill();
      }
    }

    const interval = 1000 / CONFIG.fps;
    function frame(time: number) {
      if (!running) return;
      frameId = requestAnimationFrame(frame);
      if (last && time - last < interval - 1) return; // giữ ~30 khung/giây
      const dt = last ? Math.min(6, (time - last) / 16.67) : 1;
      last = time;
      step(dt);
      draw();
    }

    function start() {
      if (running) return;
      running = true;
      last = 0;
      frameId = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(frameId);
    }

    resize();
    start();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        pointer.x = event.clientX;
        pointer.y = event.clientY;
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () => {
      pointer.x = pointer.y = -1e4;
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
  }
</script>

<style>
  .net-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Nền đứng yên (vẽ một lần): vài đốm sáng mờ + quầng sáng + gradient tối.
       Canvas phía trên chỉ vẽ điểm và đường nối. */
    background:
      radial-gradient(circle at 18% 28%, rgba(120, 200, 220, 0.1), transparent 9%),
      radial-gradient(circle at 78% 18%, rgba(120, 200, 220, 0.08), transparent 11%),
      radial-gradient(circle at 64% 78%, rgba(120, 200, 220, 0.12), transparent 10%),
      radial-gradient(circle at 30% 82%, rgba(120, 200, 220, 0.07), transparent 12%),
      radial-gradient(circle at 90% 60%, rgba(120, 200, 220, 0.09), transparent 8%),
      radial-gradient(ellipse at 55% 65%, rgba(40, 120, 140, 0.35), transparent 70%),
      linear-gradient(160deg, #08161d, #103846);
  }
</style>
